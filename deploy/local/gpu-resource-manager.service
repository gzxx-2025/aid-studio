[Unit]
Description=AID GPU Resource Manager API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aid-gpu-manager
Group=aid-gpu-manager
EnvironmentFile=/etc/aid-gpu-manager.env
WorkingDirectory=/opt/aid-studio
ExecStart=/usr/bin/python3 /opt/aid-studio/deploy/local/gpu_resource_manager.py --host 127.0.0.1 --port 18120 --db /var/lib/aid-gpu-manager/gpu-manager.db --profiles /etc/aid-gpu-profiles.json --services /etc/aid-gpu-services.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aid-gpu-manager

[Install]
WantedBy=multi-user.target
