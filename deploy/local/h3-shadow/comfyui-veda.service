ExecStart=/home/neo/comfyui-fasth3-shadow/env-cu130/bin/python /home/neo/comfyui-h3-veda-039/ComfyUI/main.py --listen 0.0.0.0 --port 8192 --cuda-device 0 --disable-async-offload --reserve-vram 2 --extra-model-paths-config /home/neo/comfyui-fasth3-shadow/extra_model_paths.yaml
